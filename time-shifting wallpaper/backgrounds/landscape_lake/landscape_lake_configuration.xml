  		<duration>23400.0</duration> <!-- Image will change after a certain duration in seconds. So one hour are 3600s. -->
 		<file>/usr/share/backgrounds/gnome/landscape_lake/landscape_lake_23:00.jpg</file> <!-- path to file -->
